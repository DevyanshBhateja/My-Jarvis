# Jarvis Environment Configuration Template
# Copy this file to .env and insert your personal API keys

# NVIDIA NIM Developer Cloud API Key (Optional, used for cloud reasoning models)
# Get a free key at https://build.nvidia.com
NVIDIA_API_KEY="your_nvidia_api_key_here"

# Routing: 'auto' routes simple turns to local Ollama and complex turns to NVIDIA NIM cloud
# Options: 'auto' | 'local' | 'nvidia'
JARVIS_LLM_ROUTE="auto"

# Cloud Model (NVIDIA NIM)
JARVIS_NVIDIA_MODEL="meta/llama-3.2-90b-vision-instruct"
JARVIS_NVIDIA_URL="https://integrate.api.nvidia.com/v1"

# Local Edge Model (Ollama)
JARVIS_LOCAL_MODEL="qwen2.5:3b"
JARVIS_OLLAMA_URL="http://127.0.0.1:11434"

# Coqui Neural TTS Model (VITS pinned for 4GB VRAM budget compliance per ADR-001)
JARVIS_TTS_MODEL="tts_models/en/ljspeech/vits"

# Default Location for Local Information and Weather Telemetry
JARVIS_DEFAULT_LOCATION="Pori"

